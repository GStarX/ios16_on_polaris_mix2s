index 0000000..2b0bdd8
--- /dev/null
+++ b/bsd/dev/polaris_keys.c
@@ -0,0 +1,241 @@
+/*
+ * POLARIS: PM8998 power / volume keys over the SDM845 SPMI PMIC arbiter.
+ *
+ * Ported from bsd/dev/sweet_keys.c (proven on sweet / SM7150) using the
+ * stock polaris device tree in the 48-DTB chain of boot.img:
+ *
+ *   /soc/qcom,spmi@c440000/qcom,pm8998@0/qcom,power-on@800
+ *       qcom,pon_1  qcom,pon-type = <0>  linux,code = <116 KEY_POWER>
+ *       qcom,pon_2  qcom,pon-type = <1>  linux,code = <114 KEY_VOLUMEDOWN>
+ *   /soc/gpio_keys/vol_up
+ *       gpios = <&pm8998_gpios 6 GPIO_ACTIVE_LOW>
+ *       linux,code = <115 KEY_VOLUMEUP>, debounce-interval = <15>
+ *
+ * The SPMI arbiter MMIO windows, the PON 0x810 register and the key
+ * polarity are identical to sweet_keys.c; only the volume-up GPIO page
+ * and RT-status register differ (PM8998 SID0 GPIO6 at page 0xc5 instead
+ * of PM6150L SID4 GPIO2 at page 0xc1).
+ *
+ * Access is READ ONLY: the sole MMIO write issues an EXT_READL observer
+ * command. No PMIC configuration, IRQ acknowledge or reset writes exist.
+ * Keys are polled at 20 ms, the same model as the proven sweet driver.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+/* Vendor adt.c:0979d1d4e6b8 map view from 0084 polaris_touch_diag.c. */
+extern bool polaris_touch_board(void);
+void polaris_keys_init(void);
+
+/* polaris DTB: spmi@c440000 reg-names core / chnls / obsrvr / intr / cnfg. */
+#define PK_CORE_PA   0x0c440000u
+#define PK_OBS_PA    0x0e600000u
+#define PK_CNFG_PA   0x0c40a000u
+/* PM8998 SID 0 PON at 0x800: PPID = (SID << 8) | (addr >> 8). */
+#define PK_PON_RT    0x0810u	/* bit0 KPDPWR (power), bit1 RESIN (volume-down) */
+/* PM8998 SID 0 GPIO6 block at 0xc500 (GPIO n -> 0xc000 + (n-1)*0x100). */
+#define PK_GPIO_RT   0xc510u	/* INT_RT_STS, bit0 = high state (active-low key) */
+#define PK_GPIO_STS1 0xc508u	/* STATUS1, polled for the diagnostic line */
+#define PK_GPIO_MODE 0xc540u
+#define PK_GPIO_EN   0xc546u
+#define PK_GPIO_SUB  0xc505u
+#define PK_PON_APID  0x008u	/* SID0 page 0x08: PON */
+#define PK_GPIO_APID 0x0c5u	/* SID0 page 0xc5: GPIO6 */
+#define PK_APID_NONE 0xffffu
+#define PK_POLL_MS   20u
+
+static vm_offset_t pk_core, pk_obs, pk_cnfg;
+static uint16_t pk_pon_apid = PK_APID_NONE, pk_gpio_apid = PK_APID_NONE;
+static uint32_t pk_last_status;
+static int pk_sleep_chan;
+static int pk_diag;
+static bool pk_started;
+
+static uint32_t
+pk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+pk_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = PK_APID_NONE;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = pk_rd(pk_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = pk_rd(pk_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == PK_APID_NONE || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+pk_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == PK_APID_NONE) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid; /* observer channel, EE(0) */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(pk_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		pk_last_status = pk_rd(pk_obs, off + 0x08u);
+		if (pk_last_status & 1u) {
+			if (pk_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)pk_rd(pk_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+pk_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(PK_POLL_MS, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&pk_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * key 0 power, 1 volume-up, 2 volume-down -> sweet_hid_key() usages
+ * (kHIDUsage_Csmr_Power 0x30 / VolumeIncrement 0xE9 / VolumeDecrement
+ * 0xEA), exactly the proven sweet mapping in SweetHID.cpp.
+ */
+static void
+pk_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	unsigned last_pon = ~0u, last_gpio = ~0u, last_sts = ~0u;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0, sts1 = 0;
+		bool pok = pk_read(pk_pon_apid, PK_PON_RT, &pon);
+		bool gok = pk_read(pk_gpio_apid, PK_GPIO_RT, &gpio);
+		bool s1ok = pk_read(pk_gpio_apid, PK_GPIO_STS1, &sts1);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("POLARIS KEYS: read error pon-ok=%d gpio6-ok=%d arb-status=%#x\n",
+				    pok, gok, pk_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		if (pk_diag && (pon != last_pon || gpio != last_gpio || sts1 != last_sts)) {
+			printf("POLARIS KEYS: raw pon=%#x gpio6-rt=%#x gpio6-sts1=%#x%s\n",
+			    pon, gpio, sts1, s1ok ? "" : " (sts1 unreadable)");
+			last_pon = pon;
+			last_gpio = gpio;
+			last_sts = sts1;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("POLARIS KEYS: key=%s down=%d pon=%#x gpio6-rt=%#x sts1=%#x\n",
+				    k == 0 ? "power" : (k == 1 ? "volup" : "voldown"),
+				    state[k], pon, gpio, sts1);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		pk_wait();
+	}
+}
+
+void
+polaris_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (pk_started) {
+		return;
+	}
+	pk_started = true;
+	(void)PE_parse_boot_argn("polariskeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("POLARIS KEYS: disabled (polariskeys=0)\n");
+		return;
+	}
+	if (!polaris_touch_board()) {
+		printf("POLARIS KEYS: xiaomi,polaris/qcom,sdm845 not confirmed; PMIC driver prohibited\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("polariskeydiag", &pk_diag, sizeof(pk_diag));
+	pk_core = ml_io_map(PK_CORE_PA, 0x2000);
+	pk_cnfg = ml_io_map(PK_CNFG_PA, 0x1000);
+	pk_obs = ml_io_map(PK_OBS_PA, 0x10000);
+	if (!pk_core || !pk_cnfg || !pk_obs) {
+		printf("POLARIS KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t version = pk_rd(pk_core, 0);
+	uint32_t count = pk_rd(pk_core, 4) & 0x7ffu;
+	if (version < 0x50000000u || version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("POLARIS KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    version, count);
+		return;
+	}
+	pk_pon_apid = pk_find_apid(PK_PON_APID, count);
+	pk_gpio_apid = pk_find_apid(PK_GPIO_APID, count);
+	uint8_t pon = 0, gpio = 0, sts1 = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = pk_read(pk_pon_apid, PK_PON_RT, &pon);
+	bool gok = pk_read(pk_gpio_apid, PK_GPIO_RT, &gpio);
+	bool s1ok = pk_read(pk_gpio_apid, PK_GPIO_STS1, &sts1);
+	bool mok = pk_read(pk_gpio_apid, PK_GPIO_MODE, &mode);
+	bool eok = pk_read(pk_gpio_apid, PK_GPIO_EN, &en);
+	bool sok = pk_read(pk_gpio_apid, PK_GPIO_SUB, &subtype);
+	printf("POLARIS KEYS: arb=%#x apids=%u pon-apid=%u gpio6-apid=%u "
+	    "pon=%#x/%d gpio6-rt=%#x/%d sts1=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d diag=%d\n",
+	    version, count, pk_pon_apid, pk_gpio_apid,
+	    pon, pok, gpio, gok, sts1, s1ok, mode, mok, en, eok, subtype, sok, pk_diag);
+	/*
+	 * GPIO configuration belongs to firmware (ABL configures the key
+	 * pins for fastboot key detection). Diagnose it, never repair it.
+	 * Withhold volume-up when the pin is not confirmed as an input:
+	 * an unconfigured pin must not be reported as a permanently pressed
+	 * key. Read-only access keeps this check free of side effects.
+	 */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!gok || !sok || !mok || !eok || !(en & 0x80u) ||
+	    (dir != 0 && dir != 2)) {
+		printf("POLARIS KEYS: GPIO6 not confirmed enabled as input; "
+		    "volume-up withheld, PMIC unchanged\n");
+		pk_gpio_apid = PK_APID_NONE;
+	}
+	if (!pok && pk_gpio_apid == PK_APID_NONE) {
+		printf("POLARIS KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(pk_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("POLARIS KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
