diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 82d8ecd..bcb50cf 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -430,6 +430,32 @@ AppleCLCD::setProperties(OSObject *properties)
 	return kIOReturnSuccess;
 }
 
+/*
+ * 0098: measurement only, no behavior change. presents counts
+ * completed present() calls (a call can skip every surface and write
+ * no pixels, so this is NOT a displayed-frame count); present_ns
+ * accumulates absolutetime_to_nanoseconds()-converted time spent
+ * inside present(). Both are printed once per 300 vsync callbacks.
+ * sweet_fb_swap_count is incremented outside fLock in swap(); a stat
+ * line may read a torn/lagging value -- accepted for statistics, no
+ * locking is added for them.
+ */
+static uint64_t sweet_fb_present_count;
+static uint64_t sweet_fb_present_ns;
+
+static void
+sweet_fb_stat(uint64_t count, uint64_t now, uint32_t nclients,
+    uint32_t flush_ticks, int poweroff)
+{
+	uint64_t time_ns = 0;
+
+	absolutetime_to_nanoseconds(now, &time_ns);
+	IOLog("SWEET FB: stat vsync=%llu time_ns=%llu swaps=%llu presents=%llu present_ns=%llu clients=%u flush=%u poweroff=%d\n",
+	    count, time_ns, sweet_fb_swap_count,
+	    sweet_fb_present_count, sweet_fb_present_ns,
+	    nclients, flush_ticks, poweroff);
+}
+
 void
 AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 {
@@ -448,6 +474,8 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
 		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
 	}
+	/* 0098: snapshot taken under the already-held lock; no new locking. */
+	uint32_t nclients = fb->fClients->getCount();
 	if (fb->fPowerOff) {
 		/* Fade out: halve every channel each vsync, then black, then idle. */
 		uint32_t step = fb->fFadeStep;
@@ -463,6 +491,12 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 				}
 			}
 		}
+		/* 0098: stat covers the poweroff path too -- the fade loop
+		 * lengthens these callback intervals, so rows must carry
+		 * poweroff=1 to keep rate math honest. */
+		if ((count % 300) == 0) {
+			sweet_fb_stat(count, now, nclients, fb->fFlushTicks, 1);
+		}
 		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 		return;
 	}
@@ -477,9 +511,28 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	}
 	IOLockUnlock(fb->fLock);
 	if (rec != NULL) {
+		/*
+		 * 0098: time the real present() call. mach_absolute_time
+		 * ticks converted with absolutetime_to_nanoseconds()
+		 * (osfmk/kern/clock.h), same API the bsd side uses.
+		 */
+		uint64_t t0 = mach_absolute_time();
+		uint64_t ns = 0;
 		fb->present(rec);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		sweet_fb_present_count++;
+		sweet_fb_present_ns += ns;
 		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
 	}
+	if ((count % 300) == 0) {
+		/*
+		 * 0098: periodic stat line, every 300 vsync callbacks. The
+		 * timer is one-shot and re-armed after present(), so the
+		 * wall time between rows is NOT 300 x 16667us -- compute
+		 * rates from the real time_ns deltas.
+		 */
+		sweet_fb_stat(count, now, nclients, fb->fFlushTicks, 0);
+	}
 	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 }
 
