diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..3c050f0 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -10,7 +10,10 @@
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
- * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * First sample sweetsmp_first s after start (default 5 s), then every
+ * sweetsmp_every s (default 15 s), sweetsmp_count samples at most
+ * (default 40). 0099: pulled in from 90 s / 120 s / 40 so samples land
+ * inside the early zero-commit window, not only the steady state.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -70,11 +73,28 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
-		printf("SMP --- sample %d\n", i);
+	/*
+	 * 0099: cadence is boot-arg tunable so measuring rhythm changes
+	 * need no reflash. Defaults 5/15/40: first sample at 5 s lands
+	 * inside the early zero-commit window (stat lines showed no swaps
+	 * from ~5 s to ~82 s after boot), 15 s spacing, 40 samples cover
+	 * to ~615 s (zero-commit plus steady state for comparison).
+	 */
+	unsigned int first = 5, every = 15, count = 40;
+	(void)PE_parse_boot_argn("sweetsmp_first", &first, sizeof(first));
+	(void)PE_parse_boot_argn("sweetsmp_every", &every, sizeof(every));
+	(void)PE_parse_boot_argn("sweetsmp_count", &count, sizeof(count));
+	if (every == 0) {
+		every = 15;
+	}
+	if (count == 0) {
+		count = 40;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", first * hz);
+	for (unsigned int i = 0; i < count; i++) {
+		printf("SMP --- sample %u\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", every * hz);
 	}
 }
 
