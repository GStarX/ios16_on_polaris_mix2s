+/*
+ * Software gamma: scale the 8-bit B/G/R channels towards black and keep
+ * alpha. 256 is the identity. Temporary execution backend for the P0
+ * brightness service until the PMI8998 WLED driver (P1) owns the hardware.
+ */
+static inline uint32_t
+sweet_dim_pixel(uint32_t p, uint32_t scale)
+{
+	uint32_t b = ((p & 0x000000ffu) * scale) >> 8;
+	uint32_t g = (((p >> 8) & 0x000000ffu) * scale) >> 8;
+	uint32_t r = (((p >> 16) & 0x000000ffu) * scale) >> 8;
+	return (p & 0xff000000u) | (r << 16) | (g << 8) | b;
 }
 
