+/*
+ * Software gamma backend for P0: nits (16.16) -> panel level (0..0xfff) ->
+ * 0..256 linear pixel scale. P1 replaces fDimScale with a real PMI8998
+ * WLED sink-current write; this path stays as the fallback.
+ */
+bool
+AppleCLCD::startBacklightService(void)
+{
+	uint32_t enable = 0;
+	AppleARMBacklight *bl;
+
+	if (!PE_parse_boot_argn("sweetbl", &enable, sizeof(enable)) || enable == 0) {
+		return false;   /* opt-in: CoreBrightness may also enable digital dimming */
+	}
+	bl = OSTypeAlloc(AppleARMBacklight);
+	if (bl == NULL || !bl->init()) {
+		OSSafeReleaseNULL(bl);
+		return false;
+	}
+	bl->fFB = this;
+	bl->setProperty("backlight-control", true);
+	bl->setProperty("brightness-nits", (unsigned long long)200, 32);
+	bl->setProperty("max-nits", (unsigned long long)SWEET_FB_MAX_NITS, 32);
+	if (!bl->attach(this)) {
+		OSSafeReleaseNULL(bl);
+		IOLog("SWEET FB: AppleARMBacklight attach failed\n");
+		return false;
+	}
+	bl->registerService();
+	OSSafeReleaseNULL(bl);
+	IOLog("SWEET FB: AppleARMBacklight published (max %u nits, sweetbl=1)\n",
+	    SWEET_FB_MAX_NITS);
+	return true;
+}
+
+static void
+sweet_bl_log(const char *who, OSDictionary *d)
+{
+	static uint32_t logs;
+	OSCollectionIterator *it;
+	OSSymbol *k;
+
+	if (d == NULL || logs >= 32) {
+		return;
+	}
+	it = OSCollectionIterator::withCollection(d);
+	while (it != NULL && (k = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		OSObject *v = d->getObject(k);
+		OSNumber *n = OSDynamicCast(OSNumber, v);
+		if (logs++ < 32) {
+			IOLog("SWEET BL: %s set %s = %s %llu\n", who, k->getCStringNoCopy(),
+			    v != NULL ? v->getMetaClass()->getClassName() : "null",
+			    n != NULL ? n->unsigned64BitValue() : 0ULL);
+		}
+	}
+	OSSafeReleaseNULL(it);
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSDictionary *m = NULL;
+	OSNumber *n = d != NULL ? OSDynamicCast(OSNumber, d->getObject("brightness-nits")) : NULL;
+	OSNumber *nn = NULL;
+	uint64_t v;
+
+	sweet_bl_log("backlight", d);
+	if (n == NULL || fFB == NULL) {
+		return kIOReturnSuccess;
+	}
+	v = n->unsigned64BitValue();
+	if (v < 0x10000) {
+		v <<= 16;               /* plain nits -> 16.16, same scale as IOMFB */
+	}
+	nn = OSNumber::withNumber(v, 64);
+	m = OSDictionary::withCapacity(1);
+	if (nn != NULL && m != NULL) {
+		m->setObject("IOMFBBrightnessLevel", nn);
+		(void)fFB->setProperties(m);
+	}
+	OSSafeReleaseNULL(nn);
+	OSSafeReleaseNULL(m);
+	setProperty("brightness-nits", n);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = NULL;
+	uint64_t v = 0;
+	uint32_t level, dim;
+
+	sweet_bl_log("iomfb", d);
+	if (d == NULL) {
+		return kIOReturnUnsupported;
+	}
+	n = OSDynamicCast(OSNumber, d->getObject("IOMFBBrightnessLevel"));
+	if (n != NULL) {
+		v = n->unsigned64BitValue();
+	} else {
+		n = OSDynamicCast(OSNumber, d->getObject("brightness-nits"));
+		if (n == NULL) {
+			return kIOReturnUnsupported;
+		}
+		v = n->unsigned64BitValue();
+		if (v < 0x10000) {
+			v <<= 16;
+		}
+	}
+	setProperty("IOMFBBrightnessLevel", v, 32);
+	level = (uint32_t)((v * SWEET_FB_MAX_LEVEL) / ((uint64_t)SWEET_FB_MAX_NITS << 16));
+	if (level > SWEET_FB_MAX_LEVEL) {
+		level = SWEET_FB_MAX_LEVEL;
+	}
+	dim = (level * SWEET_FB_DIM_MAX + SWEET_FB_MAX_LEVEL / 2) / SWEET_FB_MAX_LEVEL;
+	IOLockLock(fLock);
+	fDimScale = dim;
+	fDirty = true;          /* redraw the latest frame with the new gamma */
+	IOLockUnlock(fLock);
+	if (fBrightnessLogs++ < 16) {
+		IOLog("SWEET FB: brightness %llu nits (16.16) -> level %#x, gamma %u/%u\n",
+		    v, level, dim, SWEET_FB_DIM_MAX);
+	}
+	return kIOReturnSuccess;
 }
 
